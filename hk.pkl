amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  // Lints and formats JS, TS, JSON, CSS, and the markup in .svelte files.
  ["biome"] = (Builtins.biome) {
    // The builtin only matches JS, TS and JSON.
    glob = List("**/*.{js,ts,json,jsonc,css,html,svelte}")
    check = "biome check --no-errors-on-unmatched --files-ignore-unknown=true {{ files }}"
    fix = "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true {{ files }}"
  }
  ["format"] {
    glob = List("src-tauri/**/*.rs")
    exclusive = true
    fix = "mise run format"
  }
  ["lint"] {
    glob = List("src-tauri/**/*.rs")
    exclusive = true
    check = "mise run lint"
  }
  ["svelte-check"] {
    glob = List("src/**/*.{ts,js,svelte}")
    exclusive = true
    check = "mise run check"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}
